---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, description, align = 'center' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' ? 'mx-auto text-center' : 'text-left']}>
  {eyebrow && (
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600 mb-3">{eyebrow}</p>
  )}
  <h2 class="font-display font-bold text-3xl sm:text-4xl tracking-tight text-ink-900 text-balance">{title}</h2>
  {description && <p class="mt-3 text-slate-600 leading-relaxed text-pretty">{description}</p>}
</div>
