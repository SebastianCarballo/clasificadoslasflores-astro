---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CategoryGrid from '@/components/CategoryGrid.astro';
import BusinessCard from '@/components/BusinessCard.astro';
import PlanCard from '@/components/PlanCard.astro';
import Icon from '@/components/Icon.astro';
import { listBusinesses } from '@/data/businesses';
import { listCategories } from '@/data/categories';
import { listPlans } from '@/data/plans';
import { organizationSchema } from '@/utils/site';

const businesses = await listBusinesses();
const categories = await listCategories();
const plans = await listPlans();

const destacados = businesses.filter((b) => b.plan === 'oro' || b.featured).slice(0, 3);
const recientes = [...businesses].sort((a, b) => b.createdAt.localeCompare(a.createdAt)).slice(0, 6);

// Prueba social real, calculada en build desde las collections (sin inventar nada)
const totalResenas = businesses.reduce((acc, b) => acc + b.reviewsCount, 0);
const ratingPromedio = (businesses.reduce((acc, b) => acc + b.rating, 0) / businesses.length).toFixed(1);
const pctVerificados = Math.round((businesses.filter((b) => b.verified).length / businesses.length) * 100);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Clasificados Las Flores',
    url: 'https://clasificadoslasflores.com.ar',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://clasificadoslasflores.com.ar/directorio?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  },
  organizationSchema(),
];
---

<BaseLayout
  title="Clasificados Las Flores — Comercios, servicios y oficios locales"
  description="El directorio digital de Las Flores, Buenos Aires. Encontrá plomeros, restaurantes, alquileres, tiendas y empleo local. Contacto directo por WhatsApp."
  schema={schema}
>
  {/* HERO */}
  <section class="relative overflow-hidden bg-ink-950 text-white">
    <div
      class="absolute inset-0 bg-gradient-to-br from-brand-700 via-indigo-700 to-ink-950"
      aria-hidden="true"
    />
    <div class="absolute inset-0 dot-grid" aria-hidden="true" />
    <div
      class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-brand-500/30 blur-3xl float-soft"
      aria-hidden="true"
    />
    <div
      class="absolute -bottom-32 -left-24 w-80 h-80 rounded-full bg-amber-500/15 blur-3xl float-soft-delayed"
      aria-hidden="true"
    />
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
      <div class="max-w-3xl" data-reveal>
        <p
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/15 text-xs font-semibold mb-5">
          <span class="relative flex w-2 h-2" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
          </span>
          📍 Las Flores · Buenos Aires · Directorio verificado
        </p>
        <h1 class="font-display font-extrabold text-4xl sm:text-6xl leading-[1.05] tracking-tight text-balance">
          Todo Las Flores,<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 to-orange-400">
            en un solo lugar.
          </span>
        </h1>
        <p class="mt-5 text-lg text-slate-300 max-w-xl leading-relaxed">
          Del plomero de urgencias a la carta de tu restaurante favorito. Buscá, compará y
          contactá por WhatsApp en segundos.
        </p>

        {/* Buscador (progresivo: funciona sin JS vía GET) */}
        <form
          action="/directorio"
          method="get"
          role="search"
          data-event="buscar"
          class="mt-8 bg-white rounded-2xl p-2 flex flex-col sm:flex-row gap-2 shadow-2xl max-w-2xl">
          <label class="sr-only" for="q">Buscar comercios o servicios</label>
          <input
            id="q"
            name="q"
            type="search"
            inputmode="search"
            enterkeyhint="search"
            placeholder="¿Qué buscás? Ej: plomero, pizza, alquiler…"
            autocomplete="off"
            class="flex-1 px-4 py-3 rounded-xl text-ink-900 outline-none placeholder:text-slate-400"
          />
          <button
            type="submit"
            class="px-6 py-3 rounded-xl bg-brand-600 font-bold text-white hover:bg-brand-700 active:scale-[0.98] transition inline-flex items-center gap-2 btn-sheen">
            <Icon name="search" size={17} /> Buscar
          </button>
        </form>

        <div class="mt-4 flex flex-wrap gap-2 text-sm">
          <span class="text-slate-400 py-1.5">Populares:</span>
          {
            ['Plomero', 'Pizza', 'Alquiler', 'Café'].map((t) => (
              <a
                href={`/directorio?q=${encodeURIComponent(t)}`}
                class="px-4 py-2 rounded-full bg-white/10 border border-white/15 hover:bg-white/20 transition-colors">
                {t}
              </a>
            ))
          }
        </div>
      </div>

      {/* Stats — números reales, sin multiplicadores */}
      <dl class="mt-12 grid grid-cols-3 max-w-xl gap-4 text-center sm:text-left">
        <div><dt class="text-xs uppercase tracking-wider text-slate-400">Negocios</dt><dd class="font-display font-extrabold text-2xl">{businesses.length}</dd></div>
        <div><dt class="text-xs uppercase tracking-wider text-slate-400">Categorías</dt><dd class="font-display font-extrabold text-2xl">{categories.length}</dd></div>
        <div><dt class="text-xs uppercase tracking-wider text-slate-400">Reseñas</dt><dd class="font-display font-extrabold text-2xl">{totalResenas}</dd></div>
      </dl>
    </div>
  </section>

  {/* PRUEBA SOCIAL — datos reales del directorio */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10" aria-label="Confianza de la comunidad">
    <dl class="grid grid-cols-3 gap-3 sm:gap-4 max-w-3xl mx-auto text-center">
      <div class="bg-white rounded-2xl border border-ink-100 px-3 py-4 shadow-sm">
        <dd class="font-display font-extrabold text-2xl text-ink-900">★ {ratingPromedio}</dd>
        <dt class="text-xs text-slate-500 mt-1">promedio en {totalResenas} reseñas</dt>
      </div>
      <div class="bg-white rounded-2xl border border-ink-100 px-3 py-4 shadow-sm">
        <dd class="font-display font-extrabold text-2xl text-ink-900">{pctVerificados}%</dd>
        <dt class="text-xs text-slate-500 mt-1">perfiles verificados</dt>
      </div>
      <div class="bg-white rounded-2xl border border-ink-100 px-3 py-4 shadow-sm">
        <dd class="font-display font-extrabold text-2xl text-ink-900">{businesses.length}</dd>
        <dt class="text-xs text-slate-500 mt-1">negocios publicados</dt>
      </div>
    </dl>
  </section>

  {/* CATEGORÍAS */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-14">
    <SectionHeading
      eyebrow="Explorá"
      title="Buscá por categoría"
      description="Gastronomía, oficios, inmuebles, vehículos, empleo y más — todo de vecinos verificados."
    />
    <div class="mt-8" data-reveal><CategoryGrid /></div>
  </section>

  {/* DESTACADOS ORO */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-16">
    <div class="flex items-end justify-between gap-4 mb-7">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-amber-600 mb-2">★ Alianza Oro</p>
        <h2 class="font-display font-bold text-3xl tracking-tight">Comercios destacados</h2>
      </div>
      <a href="/directorio" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:underline slide-arrow">Ver directorio <Icon name="arrow-right" size={15} /></a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-reveal-group>
      {destacados.map((b) => <BusinessCard business={b} />)}
    </div>
  </section>

  {/* BANNER PUBLICITARIO */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-14" aria-label="Publicidad local">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-emerald-700 to-teal-800 text-white p-8 sm:p-12">
      <div class="max-w-xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-white">Fiesta local · Espacio sponsor</p>
        <h2 class="mt-2 font-display font-extrabold text-2xl sm:text-4xl">Tu evento o marca acá: banner rotativo</h2>
        <p class="mt-3 text-emerald-50">Llegá a los vecinos cada semana. Contratá tu destacado de 7 o 15 días.</p>
        <a href="/contacto" class="mt-5 inline-flex px-5 py-3 rounded-xl bg-white text-emerald-700 font-bold text-sm hover:bg-emerald-50">Quiero publicitar →</a>
      </div>
    </div>
  </section>

  {/* RECIENTES */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-16">
    <SectionHeading eyebrow="Novedades" title="Últimos agregados" description="Los perfiles más nuevos de la comunidad." />
    <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-reveal-group>
      {recientes.map((b) => <BusinessCard business={b} />)}
    </div>
    <div class="text-center mt-8">
      <a href="/directorio" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:underline slide-arrow">Ver todo el directorio <Icon name="arrow-right" size={15} /></a>
    </div>
  </section>

  {/* CÓMO FUNCIONA — timeline editorial con mocks visuales */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-16" aria-labelledby="como-funciona">
    <div class="relative overflow-hidden rounded-[2rem] bg-ink-950 text-white p-8 sm:p-12">
      <div class="absolute inset-0 dot-grid" aria-hidden="true" />
      <div class="absolute -top-28 left-1/3 w-96 h-96 rounded-full bg-brand-600/25 blur-3xl float-soft" aria-hidden="true" />
      <div class="relative" data-reveal>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-amber-300">Cómo funciona</p>
        <h2 id="como-funciona" class="mt-2 font-display font-extrabold text-3xl sm:text-4xl tracking-tight text-balance">De la búsqueda al WhatsApp en 3 pasos</h2>
        <p class="mt-3 text-slate-300 max-w-xl">Sin cuentas ni vueltas: así se usa el directorio, tanto para vecinos como para negocios.</p>
      </div>

      <ol class="relative mt-10 grid md:grid-cols-3 gap-10 md:gap-8" data-reveal-group>
        <span class="steps-line absolute top-[4.75rem] left-[16%] right-[16%] h-px bg-gradient-to-r from-transparent via-white/30 to-transparent hidden md:block" aria-hidden="true"></span>

        <li class="group relative rounded-2xl p-5 -m-5 hover:bg-white/5 transition-colors">
          <span class="absolute top-0 right-2 font-display font-extrabold text-7xl text-white/[0.07] select-none" aria-hidden="true">01</span>
          <div class="flex items-center gap-3">
            <span class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-500 to-indigo-500 grid place-items-center shadow-lg shadow-brand-900/40 group-hover:scale-105 transition-transform" aria-hidden="true"><Icon name="search" size={24} class="text-white" /></span>
            <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Paso 1</span>
          </div>
          <h3 class="mt-4 font-display font-bold text-xl">Buscá</h3>
          <p class="mt-1.5 text-sm text-slate-400 leading-relaxed">Filtrá por categoría o escribí lo que necesitás. Los destacados van primero.</p>
          <div class="mt-5 rounded-xl bg-white/10 border border-white/10 p-2 flex items-center gap-2" aria-hidden="true">
            <span class="flex-1 text-xs text-slate-400 px-2">plomero urgente…</span>
            <span class="w-9 h-9 rounded-lg bg-brand-500 grid place-items-center"><Icon name="search" size={15} class="text-white" /></span>
          </div>
        </li>

        <li class="group relative rounded-2xl p-5 -m-5 hover:bg-white/5 transition-colors">
          <span class="absolute top-0 right-2 font-display font-extrabold text-7xl text-white/[0.07] select-none" aria-hidden="true">02</span>
          <div class="flex items-center gap-3">
            <span class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-600 grid place-items-center shadow-lg shadow-emerald-900/40 group-hover:scale-105 transition-transform" aria-hidden="true"><Icon name="check" size={24} class="text-white" /></span>
            <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Paso 2</span>
          </div>
          <h3 class="mt-4 font-display font-bold text-xl">Verificá</h3>
          <p class="mt-1.5 text-sm text-slate-400 leading-relaxed">Priorizamos perfiles con identidad confirmada para cuidarte de estafas.</p>
          <div class="mt-5 rounded-xl bg-white/10 border border-white/10 p-3 flex items-center gap-2.5" aria-hidden="true">
            <span class="w-9 h-9 rounded-full bg-gradient-to-br from-amber-300 to-orange-500 shrink-0"></span>
            <span class="flex-1"><span class="block h-2 rounded-full bg-white/30 w-2/3"></span><span class="block h-2 rounded-full bg-white/15 w-1/3 mt-1.5"></span></span>
            <span class="text-[10px] font-bold bg-white text-ink-950 px-2.5 py-1 rounded-full">✓ Verificado</span>
          </div>
        </li>

        <li class="group relative rounded-2xl p-5 -m-5 hover:bg-white/5 transition-colors">
          <span class="absolute top-0 right-2 font-display font-extrabold text-7xl text-white/[0.07] select-none" aria-hidden="true">03</span>
          <div class="flex items-center gap-3">
            <span class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#25D366] to-emerald-700 grid place-items-center shadow-lg shadow-emerald-900/40 group-hover:scale-105 transition-transform" aria-hidden="true"><Icon name="whatsapp" size={24} class="text-white" /></span>
            <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Paso 3</span>
          </div>
          <h3 class="mt-4 font-display font-bold text-xl">Contactá</h3>
          <p class="mt-1.5 text-sm text-slate-400 leading-relaxed">Un botón con el mensaje ya redactado. Directo con el comercio, sin intermediarios.</p>
          <div class="mt-5 space-y-2" aria-hidden="true">
            <p class="bg-white text-ink-900 text-xs rounded-2xl rounded-bl-md px-3 py-2.5 w-fit max-w-full">Hola, vi tu local en Clasificados…</p>
            <p class="rounded-xl bg-[#25D366] text-white text-sm font-bold px-4 py-2.5 flex items-center gap-2 w-fit"><Icon name="whatsapp" size={16} class="text-white" /> Enviar</p>
          </div>
        </li>
      </ol>

      <div class="relative mt-10 flex flex-col sm:flex-row gap-3" data-reveal>
        <a href="/directorio" data-event="cta_directorio" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-white text-ink-900 font-bold hover:bg-brand-50 active:scale-[0.98] transition btn-sheen slide-arrow">Explorar el directorio <Icon name="arrow-right" size={17} /></a>
        <a href="/publicar" data-event="cta_publicar" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl border border-white/30 font-bold hover:bg-white/10 active:scale-[0.98] transition">Publicar mi negocio</a>
      </div>
    </div>
  </section>

  {/* PLANES */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-16" id="planes">
    <SectionHeading eyebrow="Para negocios" title="Planes que hacen crecer tu visibilidad" description="Empezá gratis y escalá cuando necesites más clientes. Sin desarrollos costosos." />
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-5" data-reveal-group>
      {plans.map((p) => <PlanCard plan={p} />)}
    </div>
  </section>

  {/* CTA FINAL */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="rounded-3xl bg-gradient-to-br from-brand-600 to-indigo-700 text-white p-10 sm:p-14 text-center">
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-balance">¿Tenés un comercio en Las Flores?</h2>
      <p class="mt-3 text-brand-100 max-w-xl mx-auto">Publicá gratis en 2 minutos y empezá a recibir consultas directas a tu WhatsApp.</p>
      <div class="mt-6 flex flex-col sm:flex-row justify-center gap-3">
        <a href="/publicar" data-event="cta_publicar" class="px-7 py-3.5 rounded-xl bg-white text-brand-700 font-bold hover:bg-brand-50 active:scale-[0.98] transition">Publicar mi negocio gratis</a>
        <a href="/planes" class="px-7 py-3.5 rounded-xl border border-white/40 font-bold hover:bg-white/10">Ver planes</a>
      </div>
      <p class="mt-4 text-sm text-brand-100">✓ Gratis · ✓ Sin tarjeta · ✓ Listo en 2 minutos</p>
    </div>
  </section>
</BaseLayout>
