---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscás no existe. Volvé al inicio o explorá el directorio de Las Flores.">
  <section class="max-w-xl mx-auto px-4 py-20 text-center">
    <p class="text-6xl" aria-hidden="true">🧭</p>
    <h1 class="mt-4 font-display font-extrabold text-4xl">404 — Nada por acá</h1>
    <p class="mt-3 text-slate-600">Quizás el comercio se mudó o el enlace cambió.</p>
    <div class="mt-6 flex justify-center gap-3">
      <a href="/" class="px-5 py-3 rounded-xl bg-ink-900 text-white text-sm font-bold">Volver al inicio</a>
      <a href="/directorio" class="px-5 py-3 rounded-xl border text-sm font-bold">Ver directorio</a>
    </div>
  </section>
</BaseLayout>
